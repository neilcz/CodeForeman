# Claude 接入配置。支持两种凭证方式（二选一）：
# A. 第三方兼容端点（如 Kimi）：填 ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN
# B. 官方订阅：两个都不填，在宿主机执行 `claude login`（裸服务直接共享 ~/.claude；
#    Docker 部署则为 `docker compose exec codeforeman claude login`）
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
API_TIMEOUT_MS=3000000
# 模型名按接入方要求设置（官方可留空走默认）
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_FABLE_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# 管理员初始密码（首次启动生效，不设置则为 admin/admin）
ADMIN_PASSWORD=
# 项目根目录：该目录下每个一级子文件夹会被自动发现为一个项目。
# 裸服务/本机开发示例：PROJECTS_DIR=/Users/you/project
# Docker 部署时此项无效（容器内固定为 /projects），改下面的 HOST_PROJECTS_DIR
PROJECTS_DIR=

# ---------- 以下为 Docker 部署专用（裸服务可忽略） ----------
# Docker 部署：宿主机项目目录，compose 会把它挂载到容器 /projects
HOST_PROJECTS_DIR=./data/projects
# Docker 部署：SSH clone/push（git@github.com:... 地址）用的 key 目录，默认 ~/.ssh。
# 容器内无交互，带 passphrase 的 key 不可用（macOS keychain 同样不可用），
# 建议为仓库生成无密码 deploy key 放到独立目录后指向它：
#   ssh-keygen -t ed25519 -f ~/.ssh/codeforeman_deploy -N ""
#   然后把 codeforeman_deploy.pub 加到 GitHub 仓库的 Deploy Keys
HOST_SSH_DIR=~/.ssh
