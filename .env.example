# Claude 接入配置。支持两种凭证方式（二选一）：
# A. 第三方兼容端点（如 Kimi）：填 ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN
# B. 官方订阅：两个都不填，容器内执行 `docker compose exec codeforeman claude login`
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
API_TIMEOUT_MS=3000000
# 模型名按接入方要求设置（官方可留空走默认）
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_FABLE_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# 管理员初始密码（首次启动生效，不设置则为 admin/admin）
ADMIN_PASSWORD=
# 项目根目录：该目录下每个一级子文件夹会被自动发现为一个项目。
# 本机开发示例：PROJECTS_DIR=/Users/you/project
# Docker 部署：把宿主机目录挂载进容器（见 docker-compose.yml），这里填容器内挂载点，如 /projects
PROJECTS_DIR=
